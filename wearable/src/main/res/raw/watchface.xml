<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="480" height="480">
    <UserConfigurations>
        <!-- HOUR INSTRUMENT SELECTION (Integer IDs for logic, String Resources for names) -->
        <ListConfiguration id="hour_idx" defaultValue="0" displayName="@string/config_hours">
            <ListOption id="0" displayName="@string/inst_wood" icon="@drawable/wood_uke_hand" />
            <ListOption id="1" displayName="@string/inst_pink" icon="@drawable/pink_uke_hand" />
            <ListOption id="2" displayName="@string/inst_violin" icon="@drawable/violin_hand" />
            <ListOption id="3" displayName="@string/inst_bow" icon="@drawable/bow_hand" />
            <ListOption id="4" displayName="@string/inst_les_paul" icon="@drawable/les_paul_hand" />
            <ListOption id="5" displayName="@string/inst_gibson" icon="@drawable/gibson_flying_v_hand" />
            <ListOption id="6" displayName="@string/inst_saxophone" icon="@drawable/saxophone_hand" />
            <ListOption id="7" displayName="@string/inst_oboe" icon="@drawable/oboe_hand" />
            <ListOption id="8" displayName="@string/inst_harp" icon="@drawable/celtic_harp_hand" />
        </ListConfiguration>
        <!-- MINUTE INSTRUMENT SELECTION -->
        <ListConfiguration id="min_idx" defaultValue="1" displayName="@string/config_minutes">
            <ListOption id="0" displayName="@string/inst_wood" icon="@drawable/wood_uke_hand" />
            <ListOption id="1" displayName="@string/inst_pink" icon="@drawable/pink_uke_hand" />
            <ListOption id="2" displayName="@string/inst_violin" icon="@drawable/violin_hand" />
            <ListOption id="3" displayName="@string/inst_bow" icon="@drawable/bow_hand" />
            <ListOption id="4" displayName="@string/inst_les_paul" icon="@drawable/les_paul_hand" />
            <ListOption id="5" displayName="@string/inst_gibson" icon="@drawable/gibson_flying_v_hand" />
            <ListOption id="6" displayName="@string/inst_saxophone" icon="@drawable/saxophone_hand" />
            <ListOption id="7" displayName="@string/inst_oboe" icon="@drawable/oboe_hand" />
            <ListOption id="8" displayName="@string/inst_harp" icon="@drawable/celtic_harp_hand" />
        </ListConfiguration>

        <Flavors defaultValue="ukulele">
            <Flavor id="ukulele" displayName="@string/config_flavor_ukuleles">
                <Configuration id="hour_idx" optionId="0"/>
                <Configuration id="min_idx" optionId="1"/>
            </Flavor>
            <Flavor id="violins" displayName="@string/config_flavor_violin">
                <Configuration id="hour_idx" optionId="2"/>
                <Configuration id="min_idx" optionId="3"/>
            </Flavor>
            <Flavor id="guitars" displayName="@string/config_flavor_rock">
                <Configuration id="hour_idx" optionId="4"/>
                <Configuration id="min_idx" optionId="5"/>
            </Flavor>
            <Flavor id="guitars" displayName="@string/config_flavor_winds">
                <Configuration id="hour_idx" optionId="6"/>
                <Configuration id="min_idx" optionId="7"/>
            </Flavor>
        </Flavors>
    </UserConfigurations>

    <Scene>
        <PartDraw x="0" y="0" width="480" height="480">
            <Rectangle x="0" y="0" width="480" height="480"><Fill color="#000000" /></Rectangle>
        </PartDraw>

        <!-- Marks (Pushed to absolute Edge R=235) -->
        <PartImage x="225" y="5" width="30" height="83"><Image resource="twelve_oc" /></PartImage>
        <PartImage x="460" y="212" width="18" height="55"><Image resource="three_oc" /></PartImage>
        <PartImage x="219" y="430" width="41" height="47"><Image resource="six_oc" /></PartImage>
        <PartImage x="5" y="214" width="20" height="52"><Image resource="nine_oc" /></PartImage>

        <!-- Hour Dot Marks -->
        <PartImage x="357" y="42" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 1 -->
        <PartImage x="442" y="127" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 2 -->
        <PartImage x="442" y="347" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 4 -->
        <PartImage x="357" y="432" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 5 -->
        <PartImage x="117" y="432" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 7 -->
        <PartImage x="32" y="347" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 8 -->
        <PartImage x="32" y="127" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 10 -->
        <PartImage x="117" y="42" width="10" height="10"><Image resource="hour" /></PartImage> <!-- 11 -->

        <!-- Battery Staff (Shifted Left 30px, 20% Shorter) -->
        <PartDraw x="280" y="70" width="120" height="144">
            <Line startX="10" startY="20" endX="110" endY="20"><Stroke color="#666666" thickness="4" /></Line>
            <Line startX="10" startY="46" endX="110" endY="46"><Stroke color="#666666" thickness="4" /></Line>
            <Line startX="10" startY="72" endX="110" endY="72"><Stroke color="#666666" thickness="4" /></Line>
            <Line startX="10" startY="98" endX="110" endY="98"><Stroke color="#666666" thickness="4" /></Line>
            <Line startX="10" startY="124" endX="110" endY="124"><Stroke color="#666666" thickness="4" /></Line>
        </PartDraw>
        <!-- Note represents Battery: 100% over top line, 0% under bottom line -->
        <PartImage x="322" y="64" width="36" height="24">
            <Image resource="note" />
            <Transform target="y" value="64 + (100 - [BATTERY_PERCENT]) * 1.32" />
        </PartImage>

        <!-- Date (Mon AUG 17) -->
        <PartText x="0" y="330" width="480" height="60">
            <Text>
                <Font family="SYNC_TO_DEVICE" size="36" color="#cccccc">
                    <Template>%s %s %d
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[MONTH_S]" />
                        <Parameter expression="[DAY]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- MINUTE HAND ISOLATION (Scale-based binary visibility ensures NO overlapping) -->
        <Group name="MinRotation" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[MINUTE] * 6" />
            <PartImage x="193" y="30" width="95" height="300"><Image resource="wood_uke_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 0 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 0 ? 1 : 0" /></PartImage>
            <PartImage x="193" y="30" width="95" height="300"><Image resource="pink_uke_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 1 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 1 ? 1 : 0" /></PartImage>
            <PartImage x="193" y="30" width="95" height="300"><Image resource="violin_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 2 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 2 ? 1 : 0" /></PartImage>
            <PartImage x="90" y="30" width="300" height="300"><Image resource="bow_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 3 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 3 ? 1 : 0" /></PartImage>
            <PartImage x="193" y="30" width="95" height="300"><Image resource="les_paul_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 4 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 4 ? 1 : 0" /></PartImage>
            <PartImage x="193" y="30" width="95" height="300"><Image resource="gibson_flying_v_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 5 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 5 ? 1 : 0" /></PartImage>
            <PartImage x="90" y="30" width="300" height="300"><Image resource="saxophone_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 6 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 6 ? 1 : 0" /></PartImage>
            <PartImage x="90" y="30" width="300" height="300"><Image resource="oboe_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 7 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 7 ? 1 : 0" /></PartImage>
            <PartImage x="193" y="30" width="95" height="300"><Image resource="celtic_harp_hand" /><Transform target="scaleX" value="[CONFIGURATION.min_idx] == 8 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.min_idx] == 8 ? 1 : 0" /></PartImage>
        </Group>

        <!-- HOUR HAND ISOLATION (Enlarged to 260px) -->
        <Group name="HourRotation" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="([HOUR_0_11] + [MINUTE] / 60.0) * 30" />
            <PartImage x="191" y="58" width="98" height="260"><Image resource="wood_uke_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 0 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 0 ? 1 : 0" /></PartImage>
            <PartImage x="191" y="58" width="98" height="260"><Image resource="pink_uke_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 1 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 1 ? 1 : 0" /></PartImage>
            <PartImage x="191" y="58" width="98" height="260"><Image resource="violin_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 2 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 2 ? 1 : 0" /></PartImage>
            <PartImage x="110" y="58" width="260" height="260"><Image resource="bow_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 3 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 3 ? 1 : 0" /></PartImage>
            <PartImage x="191" y="58" width="98" height="260"><Image resource="les_paul_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 4 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 4 ? 1 : 0" /></PartImage>
            <PartImage x="191" y="58" width="98" height="260"><Image resource="gibson_flying_v_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 5 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 5 ? 1 : 0" /></PartImage>
            <PartImage x="110" y="58" width="260" height="260"><Image resource="saxophone_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 6 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 6 ? 1 : 0" /></PartImage>
            <PartImage x="110" y="58" width="260" height="260"><Image resource="oboe_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 7 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 7 ? 1 : 0" /></PartImage>
            <PartImage x="191" y="58" width="98" height="260"><Image resource="celtic_harp_hand" /><Transform target="scaleX" value="[CONFIGURATION.hour_idx] == 8 ? 1 : 0" /><Transform target="scaleY" value="[CONFIGURATION.hour_idx] == 8 ? 1 : 0" /></PartImage>
        </Group>

        <!-- PERFECT RED TICKING HAND -->
        <AnalogClock x="0" y="0" width="480" height="480">
            <SecondHand resource="twelve_oc" x="240" y="240" width="1" height="1" alpha="1" />
        </AnalogClock>
        <Group name="SecondRotation" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[SECOND] * 6" />
            <PartDraw x="238" y="25" width="4" height="215">
                <Rectangle x="0" y="0" width="4" height="215"><Fill color="#ff0000" /></Rectangle>
            </PartDraw>
        </Group>

        <PartDraw x="237" y="237" width="6" height="6">
            <Ellipse x="0" y="0" width="6" height="6"><Fill color="#ffffff" /></Ellipse>
        </PartDraw>
    </Scene>
</WatchFace>
