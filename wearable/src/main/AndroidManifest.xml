<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault"
        android:fullBackupContent="@xml/music_watch_face_backup"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:hasCode="false"
        tools:ignore="DataExtractionRules">

        <!-- Watch Face Format Version 2 -->
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="2" />

        <!-- Link the configuration directly to the watch face XML -->
        <meta-data
            android:name="androidx.wear.watchface.XmlConfig"
            android:resource="@raw/watchface" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
    </application>

</manifest>
