<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="480" height="480">
    <UserConfigurations>
        <!-- HOUR INSTRUMENT SELECTION -->
        <ListConfiguration id="hour_idx" defaultValue="0" displayName="@string/config_hours">
            <GENERATE_OPTIONS />
        </ListConfiguration>
        <!-- MINUTE INSTRUMENT SELECTION -->
        <ListConfiguration id="min_idx" defaultValue="1" displayName="@string/config_minutes">
            <GENERATE_OPTIONS />
        </ListConfiguration>

        <Flavors defaultValue="ukulele">
            <Flavor id="ukulele" displayName="@string/config_flavor_ukuleles"><Configuration id="hour_idx" optionId="0"/><Configuration id="min_idx" optionId="1"/></Flavor>
            <Flavor id="violins" displayName="@string/config_flavor_violin"><Configuration id="hour_idx" optionId="2"/><Configuration id="min_idx" optionId="3"/></Flavor>
            <Flavor id="rock" displayName="@string/config_flavor_rock"><Configuration id="hour_idx" optionId="4"/><Configuration id="min_idx" optionId="5"/></Flavor>
            <Flavor id="winds" displayName="@string/config_flavor_winds"><Configuration id="hour_idx" optionId="6"/><Configuration id="min_idx" optionId="7"/></Flavor>
        </Flavors>
    </UserConfigurations>

    <!-- Master Instrument List: Drives both menus and hand rendering -->
    <INSTRUMENTS>
        <INSTRUMENT index="0" name="@string/inst_wood" image="wood_uke_hand" h_x="191" h_y="58" h_w="98" h_h="260" m_x="193" m_y="30" m_w="95" m_h="300" />
        <INSTRUMENT index="1" name="@string/inst_pink" image="pink_uke_hand" h_x="191" h_y="58" h_w="98" h_h="260" m_x="193" m_y="30" m_w="95" m_h="300" />
        <INSTRUMENT index="2" name="@string/inst_violin" image="violin_hand" h_x="191" h_y="58" h_w="98" h_h="260" m_x="193" m_y="30" m_w="95" m_h="300" />
        <INSTRUMENT index="3" name="@string/inst_bow" image="bow_hand" h_x="110" h_y="58" h_w="260" h_h="260" m_x="90" m_y="30" m_w="300" m_h="300" />
        <INSTRUMENT index="4" name="@string/inst_les_paul" image="les_paul_hand" h_x="191" h_y="58" h_w="98" h_h="260" m_x="193" m_y="30" m_w="95" m_h="300" />
        <INSTRUMENT index="5" name="@string/inst_gibson" image="gibson_flying_v_hand" h_x="191" h_y="58" h_w="98" h_h="260" m_x="193" m_y="30" m_w="95" m_h="300" />
        <INSTRUMENT index="6" name="@string/inst_saxophone" image="saxophone_hand" h_x="110" h_y="58" h_w="260" h_h="260" m_x="90" m_y="30" m_w="300" m_h="300" />
        <INSTRUMENT index="7" name="@string/inst_oboe" image="oboe_hand" h_x="110" h_y="58" h_w="260" h_h="260" m_x="90" m_y="30" m_w="300" m_h="300" />
        <INSTRUMENT index="8" name="@string/inst_harp" image="celtic_harp_hand" h_x="191" h_y="58" h_w="98" h_h="260" m_x="193" m_y="30" m_w="95" m_h="300" />
    </INSTRUMENTS>

    <Scene>
        <PartDraw x="0" y="0" width="480" height="480">
            <Rectangle x="0" y="0" width="480" height="480"><Fill color="#000000" /></Rectangle>
        </PartDraw>
        <PartImage x="0" y="0" width="480" height="480">
            <Image resource="abstract_harmony" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>

        <!-- Marks (Perfectly Placed at Edge) -->
        <PartImage x="225" y="5" width="30" height="83"><Image resource="twelve_oc" /></PartImage>
        <PartImage x="460" y="212" width="18" height="55"><Image resource="three_oc" /></PartImage>
        <PartImage x="219" y="430" width="41" height="47"><Image resource="six_oc" /></PartImage>
        <PartImage x="15" y="214" width="20" height="52"><Image resource="nine_oc" /></PartImage>

        <!-- Hour Dot Marks -->
        <PartImage x="357" y="42" width="10" height="10"><Image resource="hour" /></PartImage>
        <PartImage x="442" y="127" width="10" height="10"><Image resource="hour" /></PartImage>
        <PartImage x="442" y="347" width="10" height="10"><Image resource="hour" /></PartImage>
        <PartImage x="357" y="432" width="10" height="10"><Image resource="hour" /></PartImage>
        <PartImage x="117" y="432" width="10" height="10"><Image resource="hour" /></PartImage>
        <PartImage x="32" y="347" width="10" height="10"><Image resource="hour" /></PartImage>
        <PartImage x="32" y="127" width="10" height="10"><Image resource="hour" /></PartImage>
        <PartImage x="117" y="42" width="10" height="10"><Image resource="hour" /></PartImage>

        <!-- Battery Staff -->
        <PartDraw x="300" y="80" width="100" height="144">
            <!-- 70% opacity - #B3 alpha -->
            <Line startX="10" startY="20" endX="90" endY="20"><Stroke color="#B3A3A9BA" thickness="4" /></Line>
            <Line startX="10" startY="46" endX="90" endY="46"><Stroke color="#B3A3A9BA" thickness="4" /></Line>
            <Line startX="10" startY="72" endX="90" endY="72"><Stroke color="#B3A3A9BA" thickness="4" /></Line>
            <Line startX="10" startY="98" endX="90" endY="98"><Stroke color="#B3A3A9BA" thickness="4" /></Line>
            <Line startX="10" startY="124" endX="90" endY="124"><Stroke color="#B3A3A9BA" thickness="4" /></Line>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartDraw>
        <!-- Note represents Battery: 100% over top line, 0% under bottom line -->
        <PartImage x="332" y="74" width="36" height="24">
            <Image resource="note" />
            <Transform target="y" value="74 + (100 - [BATTERY_PERCENT]) * 1.32" />
            <Transform target="alpha" value="[BATTERY_CHARGING_STATUS] ? 0 : 255" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>

        <PartImage x="332" y="74" width="36" height="24">
            <Image resource="note_ac" />
            <Transform target="y" value="74 + (100 - [BATTERY_PERCENT]) * 1.32" />
            <Transform target="alpha" value="[BATTERY_CHARGING_STATUS] ? 255 : 0" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </PartImage>

        <!-- Date -->
        <PartText x="0" y="330" width="480" height="60">
            <Text align="CENTER">
                <!-- 85% opacity - #D9 alpha -->
                <Font family="SYNC_TO_DEVICE" size="34" color="#D9B8BECE">
                    <Template>%s, %s %d
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[MONTH_S]" />
                        <Parameter expression="[DAY]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- PERFECT PINK TICKING HAND -->
        <AnalogClock x="0" y="0" width="480" height="480">
            <SecondHand resource="twelve_oc" x="240" y="240" width="1" height="1" alpha="1" />
        </AnalogClock>
        <Group name="SecondRotation" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[SECOND] * 6" />
            <PartDraw x="238" y="25" width="4" height="215">
                <Rectangle x="0" y="0" width="5" height="215"><Fill color="#FF6ACB" /></Rectangle>
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </PartDraw>
        </Group>

        <!-- MINUTE HANDS -->
        <Group name="MinRotation" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[MINUTE] * 6" />
            <GENERATE_HANDS hand_type="minute" />
        </Group>

        <!-- HOUR HANDS -->
        <Group name="HourRotation" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="([HOUR_0_11] + [MINUTE] / 60.0) * 30" />
            <GENERATE_HANDS hand_type="hour" />
        </Group>

    </Scene>
</WatchFace>
